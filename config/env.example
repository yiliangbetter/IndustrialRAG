### Nanxing RAG 客户端配置模板
### 安装向导 (/setup) 会写入 config/.env；以下默认值由程序自动覆盖，一般无需手改。

LLM_BINDING=openai
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=
LLM_MODEL=qwen-plus
# 多模态灌库（图片/表格/公式）使用的视觉模型；DashScope 推荐 qwen-vl-max
VISION_MODEL=qwen-vl-max

EMBEDDING_BACKEND=hf
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

RERANK_BY_DEFAULT=true
RERANK_BINDING=hf
RERANK_MODEL=BAAI/bge-reranker-base
# Rerank 设备：cpu | cuda | cuda:0（不设则自动选 CUDA）。与 HF_EMBED_DEVICE 独立。
# RERANK_HF_DEVICE=cpu
# Qwen CUDA 长进程 rerank 劣化缓解（见 docs/澄清门控Qwen_rerank优化方案.md）：
# RERANK_RELEASE_AFTER_PREDICT=1
# RERANK_RELEASE_AFTER_GATE=1

RAG_QUERY_MODE=mix
RAG_QUERY_DOC_FILTER=true
ENABLE_LLM_CACHE=false
# 机型检索范围规则（JSON）；可用 RAG_QUERY_DOC_FILTER_RULES_JSON 追加条目
RAG_QUERY_STEERING_PROFILES=config/query_steering_profiles.json

RAG_WEB_HOST=127.0.0.1
RAG_WEB_PORT=8765

### 以下路径与离线开关由客户端模式自动设置（指向安装目录内 data/models 等）
# HF_HOME=data/models
# HF_EMBED_OFFLINE=1
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# Web UI：知识库目录（问答与灌库共用；根目录下含 rag_storage/ 与 pipeline_parse/）
# RAG_WEB_WORKING_DIR=data/rag_storage
# RAG_WEB_PARSER_OUTPUT_DIR=data/pipeline_parse
# 也可在浏览器「查询设置 → 知识库路径」切换，会写回 .env 并热重载引擎
# TIKTOKEN_CACHE_DIR=config/tiktoken_cache

PARSER=mineru
SUMMARY_LANGUAGE=Chinese
RAG_PROMPT_LANGUAGE=zh

# 灌库模式：0=仅文本（默认更快）；1=多模态（图片/表格/公式，更慢）
RAG_WEB_ENABLE_MULTIMODAL=0
RAG_WEB_SKIP_MULTIMODAL=1

### 检索与问答配图（打包前在此调好；会随包下发，向导保存时保留，用户一般无需改）
MIN_RERANK_SCORE=0.28
RAG_IMAGE_MIN_RERANK_SCORE=0.28
# 以下 RAG_CATALOG_* / RAG_QUERY_ALIGN_* 曾在 rerank 后从 KV 注入 chunk 并写合成
# rerank_score（0.94~0.99）；已移除。table_matrix 见 RAG_TABLE_MATRIX_QUERY_BOOST。
# 灌库侧 RAG_TABLE_* 仍有效；LLM user_prompt 侧 RAG_QUERY_SUBJECT_STEER 等仍有效。
# RAG_CATALOG_QUERY_BOOST=true
# RAG_CATALOG_QUERY_RERANK=true
# RAG_CATALOG_QUERY_MIN_RERANK_SCORE=0.0
# 灌库：MinerU 表格块按 [Table] 边界整段入库（见 RAG_TABLE_AWARE_INGEST）
RAG_TABLE_AWARE_INGEST=true
# 灌库：行矩阵索引（headers + rows → kv_store_table_matrix.json）
RAG_TABLE_MATRIX_INGEST=true
# 查询：table_matrix 匹配的 sibling 表 chunk 在 rerank 前并入候选池（CrossEncoder 真实打分）；
# 若 rerank 截断后仍缺失，在 LLM batch 前补入（不写 synthetic rerank_score）。默认 true。
RAG_TABLE_MATRIX_QUERY_BOOST=true
RAG_TABLE_MATRIX_MIN_ALIGN=0.08
RAG_TABLE_MATRIX_MIN_ROWS=2
# RAG_QUERY_ALIGN_BOOST=true
RAG_QUERY_ALIGN_MIN=0.12
# RAG_QUERY_ALIGN_RERANK=0.94
RAG_QUERY_ALIGN_TOP_N=2
RAG_QUERY_ALIGN_MIN_CHARS=22
RAG_QUERY_ALIGN_ANCHOR_MIN=0.18
RAG_QUERY_SUBJECT_STEER=true
# 查询：context 中 ≥N 行 HTML 匹配筛选值时注入 table listing prompt
RAG_TABLE_FILTER_MIN_ROWS=2
RAG_IMAGE_MIN_TERM_OVERLAP=0.34
RAG_IMAGE_MIN_TERM_LEN=3
RAG_IMAGE_MIN_QUERY_CHARS=6
RAG_IMAGE_MIN_REF_ALIGN=0.28
# Plan A：inline 图仅来自 answer citation 后 chunk 内 [图片]；不扩大搜图范围
# RAG_IMAGE_TRUST_LLM_CHUNKS=1
# 默认不从 rerank 池补 chunk 进 LLM batch（缺图说明 LLM batch / citation 问题，非搜图 fallback）
RAG_LLM_RERANK_FIGURE_SUPPLEMENT=0
RAG_IMAGE_ANSWER_TOPIC_MIN_OVERLAP=0.12
# 单题短答案：query 节号/保养内容辅锚 inline 图（须过 answer 弱一致 gate；1=默认开启）
RAG_IMAGE_QUERY_SECTION_ANCHOR=1
# RAG_IMAGE_QUERY_SECTION_MIN_SCORE=0.28
# 配图扫描范围：off=整段 primary；answer=仅 top 答案行 / 同节 chunk 的 inline 图
# RAG_IMAGE_ANCHOR_MODE=off
# RAG_IMAGE_ANCHOR_MIN_LINE_OVERLAP=0.15
# RAG_IMAGE_ANCHOR_MAX_SECTIONS=1
# 配图张数上限：0=不按全局 cap 截断（实际软顶 24）；列举题仍按条目对齐
# RAG_IMAGE_MULTI_LIMIT=0
# 内联配图：图注/锚点与答案句子匹配低于此分则丢弃（宁可少图）
# RAG_IMAGE_INLINE_MIN_PLACE_SCORE=0.35

# 开发：Web UI「开发」面板开关；1=每次查询写入 logs/query_dumps/*.json
RAG_QUERY_DEBUG_DUMP=0
# 澄清/阈值标定：naive 向量粗检索分数（整问 + high/low keywords）；写入 dump 与 API
# RAG_NAIVE_RELEVANCE=1
# NAIVE_RELEVANCE_TOP_K=40

# 澄清门控 v4（见 docs/澄清门控设计方案_v4.md）
# RAG_CLARIFY_ENABLED=1
# final_score = qualifying chunks 内 max rerank（与 MIN_RERANK_SCORE 对齐）
# final=None → 拒答；final>CLARIFY_DIRECT_RERANK_MIN → 直答；否则澄清（k 条推荐均须 final>阈值）
# CLARIFY_DIRECT_RERANK_MIN=7
# CLARIFY_CANDIDATE_K=2
# CLARIFY_CANDIDATE_MAX_ROUNDS=3
# CLARIFY_CANDIDATE_MAX_PROBES=24
# CLARIFY_CANDIDATE_STRATEGY=fill_k
# CLARIFY_ONLY_NAIVE_MODE=0
# CLARIFY_CANDIDATE_MIN_RERANK_SCORE=0.28
# 路线 2：推荐问不做 rerank probe（见 docs/澄清门控优化路线.md）；点选后走全量 aquery
# CLARIFY_CANDIDATE_SKIP_PROBE=0

TOP_K=20
CHUNK_TOP_K=30
COSINE_THRESHOLD=0.33
MAX_TOTAL_TOKENS=52000
MAX_ENTITY_TOKENS=5000
MAX_RELATION_TOKENS=6500
LLM_TIMEOUT=600

# RAGAS Web-path eval (scripts/eval_ragas_webpath.py; read-only, does not touch KB)
# Install: uv sync --extra eval  (includes sentence-transformers for HF embed)
# EVAL_LLM_MODEL=qwen-plus
# EVAL_LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# EVAL_LLM_BINDING_API_KEY=
# answer_relevancy embedding — default: local HF (same as EMBEDDING_BACKEND=hf)
# EVAL_EMBEDDING_BACKEND=hf
# Or DashScope API embedding instead:
# EVAL_EMBEDDING_BACKEND=api
# EVAL_EMBEDDING_MODEL=text-embedding-v3
# EVAL_EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# EVAL_LLM_MAX_RETRIES=5
# EVAL_LLM_TIMEOUT=180
