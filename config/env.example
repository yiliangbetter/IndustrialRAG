### Nanxing RAG 客户端配置模板
### 安装向导 (/setup) 会写入 config/.env；以下默认值由程序自动覆盖，一般无需手改。

LLM_BINDING=openai
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=
LLM_MODEL=qwen-plus
# 多模态灌库（图片/表格/公式）使用的视觉模型；DashScope 推荐 qwen-vl-max
VISION_MODEL=qwen-vl-max

EMBEDDING_BACKEND=hf
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

RERANK_BY_DEFAULT=true
RERANK_BINDING=hf
RERANK_MODEL=BAAI/bge-reranker-base

RAG_QUERY_MODE=mix
RAG_QUERY_DOC_FILTER=true
ENABLE_LLM_CACHE=false
# 机型检索范围规则（JSON）；可用 RAG_QUERY_DOC_FILTER_RULES_JSON 追加条目
RAG_QUERY_STEERING_PROFILES=config/query_steering_profiles.json

RAG_WEB_HOST=127.0.0.1
RAG_WEB_PORT=8765

### 以下路径与离线开关由客户端模式自动设置（指向安装目录内 data/models 等）
# HF_HOME=data/models
# HF_EMBED_OFFLINE=1
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# RAG_WEB_WORKING_DIR=data/rag_storage
# RAG_WEB_PARSER_OUTPUT_DIR=data/pipeline_parse
# TIKTOKEN_CACHE_DIR=config/tiktoken_cache

PARSER=mineru
SUMMARY_LANGUAGE=Chinese
RAG_PROMPT_LANGUAGE=zh

# 灌库模式：0=仅文本（默认更快）；1=多模态（图片/表格/公式，更慢）
RAG_WEB_ENABLE_MULTIMODAL=0
RAG_WEB_SKIP_MULTIMODAL=1

### 检索与问答配图（打包前在此调好；会随包下发，向导保存时保留，用户一般无需改）
MIN_RERANK_SCORE=0.28
RAG_IMAGE_MIN_RERANK_SCORE=0.28
# 产品线型号总览类问题（如「南兴封边机一共有多少型号」）放宽 rerank 并补全各册「本手册适用产品型号」chunk
RAG_CATALOG_QUERY_BOOST=true
RAG_CATALOG_QUERY_RERANK=true
RAG_CATALOG_QUERY_MIN_RERANK_SCORE=0.0
# 灌库：MinerU 表格块按 [Table] 边界整段入库（见 RAG_TABLE_AWARE_INGEST）
RAG_TABLE_AWARE_INGEST=true
# 灌库：行矩阵索引（headers + rows → kv_store_table_matrix.json；不依赖 flatten）
RAG_TABLE_MATRIX_INGEST=true
# 查询：行矩阵 term 对齐补全 table chunk（通用，非 needle 补检索）
RAG_TABLE_MATRIX_QUERY_BOOST=true
RAG_TABLE_MATRIX_MIN_ALIGN=0.08
RAG_TABLE_MATRIX_MIN_ROWS=2
# 查询：context 中 ≥N 行 HTML 匹配筛选值时注入 table listing prompt
RAG_TABLE_FILTER_MIN_ROWS=2
RAG_IMAGE_MIN_TERM_OVERLAP=0.34
RAG_IMAGE_MIN_TERM_LEN=3
RAG_IMAGE_MIN_QUERY_CHARS=6
RAG_IMAGE_MIN_REF_ALIGN=0.28
# Plan A：LLM chunk 内 inline 图不再做问句 object/图注对齐（1=默认开启；0=恢复旧对齐门控）
# RAG_IMAGE_TRUST_LLM_CHUNKS=1
# 配图扫描范围：off=整段 primary；answer=仅 top 答案行 / 同节 chunk 的 inline 图
# RAG_IMAGE_ANCHOR_MODE=off
# RAG_IMAGE_ANCHOR_MIN_LINE_OVERLAP=0.15
# RAG_IMAGE_ANCHOR_MAX_SECTIONS=1
# 与澄清 upper 对齐正式 RAG 的 min rerank（设 1 时 MIN_RERANK_SCORE 取 QUERY_SCORE_THRESHOLD_UPPER）
# RAG_USE_CLARIFY_UPPER_AS_MIN_RERANK=0
# QUERY_SCORE_THRESHOLD_UPPER=0.45

# 开发：Web UI「开发」面板开关；1=每次查询写入 logs/query_dumps/*.json
RAG_QUERY_DEBUG_DUMP=0

TOP_K=20
CHUNK_TOP_K=30
COSINE_THRESHOLD=0.33
MAX_TOTAL_TOKENS=52000
MAX_ENTITY_TOKENS=5000
MAX_RELATION_TOKENS=6500
LLM_TIMEOUT=600
